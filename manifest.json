{
  "schemaVersion": 1,
  "id": "miseriae.gitarchy",
  "name": "Gitarchy",
  "version": "1.0.0",
  "author": "miseriae",
  "license": "MIT",
  "description": "Git status for watched repos in the Omarchy bar: dirty counts, branches, stash, ahead/behind, and lazygit.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Gitarchy",
    "description": "Git status for watched repos: dirty counts, branches, stash, ahead/behind, and lazygit.",
    "category": "Developer Tools",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "pollInterval": 30,
      "currentRefreshInterval": 1,
      "repos": [],
      "showBranch": true,
      "showDirty": true,
      "lazyGitMode": "focus"
    },
    "schema": [
      {
        "key": "pollInterval",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 5,
        "max": 3600,
        "step": 5,
        "defaultValue": 30
      },
      {
        "key": "currentRefreshInterval",
        "type": "integer",
        "label": "Focused repo refresh (seconds)",
        "description": "How often the focused terminal's repo is re-checked. Kept short so the bar and CURRENT row stay live while you work.",
        "min": 1,
        "max": 60,
        "step": 1,
        "defaultValue": 1
      },
      {
        "key": "showBranch",
        "type": "boolean",
        "label": "Show branch name",
        "defaultValue": true
      },
      {
        "key": "showDirty",
        "type": "boolean",
        "label": "Show dirty count",
        "defaultValue": true
      },
      {
        "key": "lazyGitMode",
        "type": "enum",
        "label": "Open lazygit in",
        "options": [
          "focus",
          "floating"
        ],
        "defaultValue": "focus",
        "description": "focus: reuse/focus an open lazygit window. floating: always open a new floating terminal."
      }
    ]
  }
}
